# Copie este arquivo para .env e preencha os valores (o .env NÃO vai para o Git)

PORT=3000

# Origem permitida no CORS (front-end Vite). Para mais de uma, separe por vírgula:
# FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/financas

# Segredo do JWT: use uma string longa e aleatória
# Dica: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h
